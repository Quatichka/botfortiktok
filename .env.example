# Токен от @BotFather
BOT_TOKEN=
# Длина одной части, секунд
SEGMENT_SECONDS=60
# Шрифт с кириллицей (пусто — скачается Nunito ExtraBold)
FONT_PATH=
# Цвет текста и плашки
TEXT_COLOR="#9B30D0"
BOX_COLOR=white
# Подпись снизу: {n} — номер части, {total} — всего частей (например: Часть {n}/{total})
PART_LABEL="PART {n}"
# crop — обрезать видео по бокам на всю ширину (как в примере), fit — вписать целиком
VIDEO_FIT=crop
# Отзеркалить видео (1 — да, 0 — нет)
MIRROR=0
# Скорость по умолчанию (1–3); каждый пользователь может выбрать свою через /speed
SPEED=1.0
# Едва заметная правка цвета основного видео (1 — без изменений)
CONTRAST=1.04
SATURATION=1.03
# Максимальная длина исходного видео, секунд
MAX_DURATION=3600
